pipeline {
    agent any
    stages {
        stage('Clean workspace'){
            steps {
                sh 'rm -rf *'
            }
        }
        stage('Clone from Github') {
            steps {
                sh 'git clone -b develope https://github.com/hasib9669/Introduction.git'
            }
        }
        stage('Compress repository') {
            steps {
                sh '7z a introduktion.7z ./'
            }
        }
    }
}
